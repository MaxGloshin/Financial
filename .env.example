# Copy to .env.local and fill values. Never commit .env.local.
APP_ENV=local
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Personal Finance
APP_TIMEZONE=Europe/Moscow
DB_PATH=./data/dev.sqlite
SESSION_TTL_DAYS=30
LOCK_TIMEOUT_MINUTES=15
RATE_LIMIT=1

# Generate: node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
SETUP_TOKEN=
DEMO_MODE=0
DEMO_TOKEN=

BACKUP_ENABLED=1
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_PASSPHRASE=

LOG_LEVEL=info

# Production (later, after explicit approval):
# APP_ENV=production
# APP_ORIGIN=https://finance.example.ru
# WEBAUTHN_RP_ID=finance.example.ru
# HOST=127.0.0.1
# DEMO_MODE=0
# STATIC_DIR=./web/dist
