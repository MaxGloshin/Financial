{
  "name": "personal-finance-pwa",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal finance PWA — IndexedDB, no backend",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "icons": "node scripts/generate-icons.mjs",
    "legacy:server": "node server/src/index.ts",
    "legacy:backup": "node scripts/backup.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
